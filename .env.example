# ContestTrade 环境变量示例
# 复制为 .env 后填入真实 key（.env 已加入 .gitignore，不会提交）
#
# 所有 key 也都可以通过 export 直接注入当前 shell

# ========== LLM（DeepSeek / OpenAI 兼容接口） ==========
# 通用 key，会覆盖 llm / llm_thinking / vlm 的 api_key
OPENAI_API_KEY=sk-your-deepseek-or-openai-key

# 如需分别配置：
# LLM_API_KEY=sk-your-deepseek-key
# LLM_THINKING_API_KEY=sk-your-deepseek-key
# VLM_API_KEY=sk-your-deepseek-key

# ========== A股数据源 ==========
TUSHARE_KEY=your-tushare-token

# ========== 搜索/海外数据源（可选） ==========
BOCHA_KEY=your-bocha-key
SERP_KEY=your-serpapi-key
FMP_KEY=your-financial-modeling-prep-key
FINNHUB_KEY=your-finnhub-key
ALPHA_VANTAGE_KEY=your-alpha-vantage-key
POLYGON_KEY=your-polygon-key
